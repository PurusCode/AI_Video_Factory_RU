# Основной провайдер — MWS GPT Model Hub

LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=

#LLM_PRIMARY_MODEL=video-farm-gpt-oss-120b-test
LLM_PRIMARY_MODEL=video-farm-gemma-4-31b-test
#LLM_PRIMARY_MODEL=video-farm-qwen-36-35b-test
# Резервный провайдер — локальная Ollama
LLM_SECONDARY_BASE_URL=http://localhost:11434/v1
LLM_SECONDARY_API_KEY=ollama
LLM_SECONDARY_MODEL=qwen2.5:14b-instruct

LLM_PRIMARY_TIMEOUT_SECONDS=120
LLM_SECONDARY_TIMEOUT_SECONDS=900
SEMANTIC_VISUAL_PLANNER_PROVIDER=secondary

# YouTube Data API v3 — нужен для анализа ниши. Получите ключ в Google Cloud Console.
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_2=

# Pexels API — нужен для скачивания коммерчески используемого B-roll и фото.

PIXABAY_API_KEY=

# Локальная озвучка 
TTS_ENGINE=kokoro
TTS_LANGUAGE=ru
TTS_SPEAKER=dima
TTS_SPEED=0.9
KOKORO_THREADS=2

# Сборка видео
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=25
VIDEO_BITRATE=4500k
VIDEO_GOP=50
