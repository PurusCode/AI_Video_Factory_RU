# LLM #1 — локальный Ollama по умолчанию.
LLM_PRIMARY_BASE_URL=http://localhost:11434/v1
LLM_PRIMARY_API_KEY=ollama
LLM_PRIMARY_MODEL=qwen2.5:3b

# Необязательный резервный OpenAI-compatible провайдер.
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Pexels / Pixabay
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Production TTS: Kokoro-ru v2, voice Dima, ONNX Runtime CPU.
# Модель и RUAccent assets хранятся локально в data/models, не в Git.
TTS_ENGINE=kokoro
TTS_LANGUAGE=ru
TTS_SPEAKER=dima
TTS_SPEED=0.9
KOKORO_THREADS=2

# Сборка видео
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=25
VIDEO_BITRATE=4500k
VIDEO_GOP=50
