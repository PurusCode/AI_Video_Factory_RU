# LLM #1 — по умолчанию локальный Ollama. Для старого CPU попробуйте hosted OpenAI-compatible API.
LLM_PRIMARY_BASE_URL=http://localhost:11434/v1
LLM_PRIMARY_API_KEY=ollama
LLM_PRIMARY_MODEL=qwen2.5:3b

# Необязательный fallback. Заполните адрес/ключ/модель провайдера, к которому у вас есть законный доступ.
# Для Yandex AI Studio, DeepSeek API, OpenRouter или другого OpenAI-compatible endpoint
# используйте именно base URL и идентификатор модели из актуальной документации провайдера.
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=

# YouTube Data API v3 — нужен для анализа ниши. Получите ключ в Google Cloud Console.
YOUTUBE_API_KEY=

# Pexels API — нужен для скачивания коммерчески используемого B-roll и фото.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Локальная озвучка Piper; модель хранится в data/models/piper. Голос Дмитрий: карточка отмечает датасет CC0.
TTS_ENGINE=piper
TTS_LANGUAGE=ru
TTS_SPEAKER=ru_RU-dmitri-medium
TTS_SPEED=0.9

# Сборка видео
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=25
VIDEO_BITRATE=4500k
VIDEO_GOP=50
